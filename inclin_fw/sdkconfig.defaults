# LCDWIKI ES3C35P: ESP32-S3-N16R8 (16 MB flash, 8 MB octal PSRAM, PSRAM unused here)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# USB-C goes straight to the ESP32-S3: log over its built-in USB Serial/JTAG
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# LVGL, matching what the LVGL Pro export needs
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_OBSERVER=y
CONFIG_LV_USE_TRANSLATION=y
CONFIG_LV_USE_FLOAT=y
CONFIG_LV_USE_THEME_SIMPLE=y
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_MEM_SIZE=98304
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_LOG_PRINTF=y
CONFIG_LV_USE_OBJ_NAME=y
